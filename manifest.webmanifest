{
  "name": "El Valle Pedidos Publicitarios",
  "short_name": "El Valle",
  "description": "PWA para gestion de pedidos de publicidad",
  "start_url": "./login.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#dde3ea",
